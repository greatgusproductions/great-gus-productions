---
export function getStaticPaths() {
  return [
    { params: { slug: "lonely-ponderosa" } },
    { params: { slug: "luke-444" } }
  ];
}

const { slug } = Astro.params;

const files = {
  "lonely-ponderosa": "/scripts/lonely-ponderosa.pdf",
  "luke-444": "/scripts/luke-444.pdf"
};

const pdf = files[slug as keyof typeof files];
---

<html>
<head>
  <title>Script Viewer</title>
  <style>
    body {
      margin: 0;
      background: black;
    }

    iframe {
      width: 100%;
      height: 100vh;
      border: none;
    }
  </style>
</head>

<body>
  {pdf ? (
    <iframe src={pdf}></iframe>
  ) : (
    <p style="color:white; padding:40px;">Script not found.</p>
  )}
</body>
</html>
