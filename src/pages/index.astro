---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Great Gus Productions"
  description="Discover original films, scripts, and creative projects from Great Gus Productions. Explore our latest releases and join our filmmaking journey."
  preloadImages={["/images/thumbnails/beyond-the-shadows-official-teaser.jpg", "/images/thumbnails/the-powwow-official-teaser.webp"]}
>

  <!-- Visually-hidden H1 and crawlable internal links for SEO (kept off-screen) -->
  <div class="visually-hidden">
    <h1>Great Gus Productions — Films, Shop, Blog, Scripts</h1>
    <nav aria-hidden="false">
      <a href="/the-powwow/">The Powwow</a>
      <a href="/beyond-the-shadows/">Beyond the Shadows</a>
      <a href="/high-note/">High Note</a>
      <a href="/about/shop/">Shop</a>
      <a href="/about/blog/">Blog</a>
      <a href="/about/scripts/">Scripts</a>
    </nav>
  </div>

  <section style="text-align:center;">
    <div class="hero-logo">
      <img
        src="/images/ggp-film-logo.webp"
        alt="Great Gus Productions Film Logo"
		class="logo-desktop"
      />

	  <img
    src="/images/ggp-film-logo-mobile.webp"
    alt="Great Gus Productions Film Logo"
    class="logo-mobile"
  />
    </div>
  </section>

  <section class="video-grid">
    {[
      { id: "C1m6VqW01qc", thumb: "/images/thumbnails/beyond-the-shadows-official-teaser.jpg", alt: "Beyond the Shadows trailer thumbnail" },
      { id: "-e2YhWVKSGY", thumb: "/images/thumbnails/the-powwow-official-teaser.webp", alt: "The Powwow trailer thumbnail" },
      { id: "EpitfgZRKjA", thumb: "/images/thumbnails/high-note-official-teaser.jpg", alt: "High Note trailer thumbnail" },
      { id: "DTtNxdlicTc", thumb: "/images/thumbnails/beyond-the-shadows-official-teaser-2.jpg", alt: "Beyond the Shadows teaser 2 thumbnail" },
      { id: "X30yUNbF9Q4", thumb: "/images/thumbnails/high-note-official-teaser-2.webp", alt: "High Note teaser 2 thumbnail" },
      { id: "V2J5x8Mvo9s", thumb: "/images/thumbnails/high-note-moonshine-and-maryjane.jpg", alt: "High Note: Moonshine and Maryjane thumbnail" },
      { id: "mMlXYVMUce8", thumb: "/images/thumbnails/ghost-of-mchenry.jpg", alt: "Ghost of McHenry thumbnail" },
      { id: "HXZwlom_PFI", thumb: "/images/thumbnails/beyond-the-shadows-opening-scene.jpg", alt: "Beyond the Shadows opening scene thumbnail" },
    ].map((video) => (
      <div class="video-item">
        <button class="video-thumb" data-id={video.id} aria-label={`Play ${video.alt}`}>
          <img src={video.thumb} alt={video.alt} loading="lazy" />
        </button>
      </div>
    ))}
  </section>

  <style>
    .video-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 45px 55px;
      margin-top: 3.5rem;
      width: 100%;
    }
	@media (max-width: 768px) {
  .video-grid {
    grid-template-columns: 1fr;
    gap: 28px;
  }
}


    .video-item {
      width: 100%;
      aspect-ratio: 16 / 9;
    }

    .video-thumb {
      position: relative;
      border: none;
      background: none;
      padding: 0;
      cursor: pointer;
    }

    .video-thumb img {
      width: 100%;
      aspect-ratio: 16 / 9;
      object-fit: cover;
      display: block;
    }

    .video-thumb:hover img {
      filter: brightness(0.70);
    }

	.video-thumb {
  overflow: hidden;
}

.video-thumb img {
  transition:
    transform 0.35s ease,
    opacity 0.45s ease;
}

.video-thumb:hover img {
  transform: scale(1.02);
}


  .hero-logo img {
  width: 100%;
  max-width: 700px;
  height: auto;
  display: block;
  margin: 0 auto;
}

.hero-logo {
  min-height: 420px;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Hide mobile logo on desktop */
.logo-mobile {
  display: none !important;
}

/* Mobile rules */
@media (max-width:768px){

  .logo-desktop {
    display: none !important;
  }

  .logo-mobile {
    display: block !important;
	width:100%;
  max-width:200px;
  margin:0 auto;
  }

  .hero-logo {
    min-height:240px;
  }
}

  </style>

  <style>
    .visually-hidden {
      position: absolute !important;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
      border: 0;
    }
    .visually-hidden a { color: inherit; }
  </style>
</BaseLayout>
