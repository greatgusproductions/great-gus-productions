---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, type CollectionEntry } from "astro:content";

const posts = (await getCollection("blog")) as CollectionEntry<"blog">[];
posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Blog | Great Gus Productions" description="Read the latest news, behind-the-scenes stories, and creative insights from the Great Gus Productions team on our official blog.">
  <section class="blog-list">
    <div class="blog-posts">
      {posts.map((post) => (
        <a href={`/about/blog/${post.slug}/`} class="blog-card">
          <div class="blog-card-img">
            {post.data.image ? <img src={post.data.image} alt={post.data.title} /> : null}
          </div>
          <div class="blog-card-content">
            <div class="blog-card-meta">
              <span class="blog-card-author">{post.data.author}</span>
              <span class="blog-card-date">
                {post.data.date.toLocaleDateString(undefined, { year: "numeric", month: "short", day: "numeric" })}
              </span>
              {post.data.readTime ? <span class="blog-card-read">• {post.data.readTime}</span> : null}
            </div>

            <h2 class="blog-card-title">{post.data.title}</h2>
            {post.data.excerpt ? <p class="blog-card-excerpt">{post.data.excerpt}</p> : <p class="blog-card-excerpt"></p>}
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
@import url('https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@300;400;600;700&display=swap');

.blog-card {
  display: flex;
  background: #181818;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 2px 12px rgba(0,0,0,0.25);
  text-decoration: none;
  color: #fff;
  transition: transform 0.15s, box-shadow 0.15s;
  width: 1000px;
  margin: 0 auto 2.5rem auto;
  height: 220px;
}

.blog-card-img { width: 340px; flex: none; }
.blog-card-img img { width: 100%; height: 100%; object-fit: cover; object-position: center; display: block; }

.blog-card:hover { transform: translateY(-4px) scale(1.01); box-shadow: 0 6px 24px rgba(0,0,0,0.35); }

.blog-card-content {
  flex: 1;
  padding: 1.5rem 1.5rem 1rem 1.5rem;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  font-family: 'Nunito Sans', 'Helvetica Neue', Helvetica, Arial, 'Liberation Sans', sans-serif;
}

.blog-card-meta { font-size: 0.95rem; color: #bbb; margin-bottom: 0.5rem; display: flex; gap: 1.2rem; }
.blog-card-title { font-size: 1.6rem; font-weight: 300; margin: 0.2rem 0 0.7rem 0; color: #fff; letter-spacing: 0.01em; }
.blog-card-excerpt { font-size: 1.02rem; color: #ccc; margin-bottom: 1.2rem; font-weight: 300; }

@media (max-width: 1100px) {
  .blog-card { width: 100%; max-width: 100vw; flex-direction: column; height: auto; }
  .blog-card-img { width: 100%; height: 180px; }
}

@media (max-width: 700px) {
  .blog-list { padding: 1rem 0 2rem 0; max-width: 100vw; }
  .blog-card { flex-direction: column; width: 98vw; height: auto; margin: 0 auto 1.2rem auto; border-radius: 8px; }
  .blog-card-img { width: 100%; height: 180px; }
  .blog-card-img img { border-radius: 8px 8px 0 0; }
  .blog-card-content { padding: 1rem 1rem 0.7rem 1rem; }
  .blog-card-title { font-size: 1.15rem; }
  .blog-card-excerpt { font-size: 0.97rem; }
  .blog-card-meta { font-size: 0.85rem; gap: 0.7rem; }
}
</style>