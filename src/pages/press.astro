  letter-spacing: 0.08em;
  margin-top: 2.5rem;
  margin-bottom: 0.75rem;
  text-transform: uppercase;
}

.legal-content p {
  color: #e6e6e6;
  line-height: 1.7;
  font-size: 0.95rem;
}
</style>